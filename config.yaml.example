# ====================== 邮箱服务器配置（以QQ邮箱为例） ======================
imap:
  server: imap.qq.com       
  port: 993

smtp:
  server: smtp.qq.com
  port: 465

# ====================== 邮箱账号 ======================
email:
  bee_address: your_bee_eamil@qq.com
  bee_password: env::BEE_EMAIL_PASSWORD
  master_email: your_master_eamil@qq.com

# ====================== 检查间隔（秒） ======================
check:
  min_interval: 3
  max_interval: 8

# ====================== 任务保存目录 ======================
task:
  dir: tasks

# ====================== AI 模型池配置 ======================
model_pool:
  # 默认模型参数（可以被每个模型单独覆盖）
  defaults:
    temperature: 0.7
    max_tokens: 2000
    top_p: 1.0
    frequency_penalty: 0.0
    presence_penalty: 0.0
    timeout: 60
    disable_proxy: false
    max_retries: 3
  
  # 模型列表
  models:
    # 1. Ollama 本地模型
    - model_id: ollama-1
      model_name: gpt-oss:120b-cloud
      model_type: OLLAMA
      api_key: null
      endpoint: http://localhost:11434/api/generate
      temperature: 0.8
      max_tokens: 4096
      timeout: 120
      system_prompt: "你是一个智能助手，请用中文回答"
      disable_proxy: true
      max_threads: 5
      model_group: LONG_TEXT
    
    # 2. 深度求索（DeepSeek）
    - model_id: deep-seek-1
      model_name: deepseek-chat
      model_type: DEEPSEEK
      api_key: env::DEEPSEEK_API_KEY
      endpoint: https://api.deepseek.com/v1/chat/completions
      temperature: 0.7
      max_tokens: 16384
      timeout: 120
      system_prompt: "你是一个智能助手"
      max_threads: 30
      model_group: HYBRID
      
      
    # 3. 阿里云百炼（DeepSeek）
    - model_id: aliyun-1
      model_name: deepseek-v4-pro
      model_type: ALIYUN_DASHSCOPE
      api_key: env::BAILIAN_API_KEY
      endpoint: https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
      temperature: 0.7
      max_tokens: 16384
      top_p: 0.9
      timeout: 120
      disable_proxy: true
      system_prompt: "你是一个智能助手"
      max_threads: 10
      model_group: HYBRID
      
    # 4. 火山方舟
    - model_id: volc-1
      model_name: ep-20260504223530-kt9mm
      model_type: VOLC_ARK
      api_key: env::ARK_API_KEY
      endpoint: https://ark.cn-beijing.volces.com/api/v3/chat/completions
      temperature: 0.7
      max_tokens: 4096
      timeout: 180
      disable_proxy: true
      system_prompt: "你是一个智能助手"
      max_threads: 5
      model_group: LITERATURE
      
    # 5. 智谱 GLM-4.7
    - model_id: zhipu-1
      model_name: glm-4.7-flash
      model_type: ZHIPU
      api_key: env::GLM_API_KEY
      endpoint: https://open.bigmodel.cn/api/paas/v4/chat/completions
      temperature: 0.7
      max_tokens: 4096
      top_p: 0.95
      timeout: 60
      system_prompt: "你是一个智能助手"
      max_threads: 1
      model_group: LIGHT_WEIGHT

    # 6. NVIDIA NIM
    - model_id: nvidia-1
      model_name: deepseek-ai/deepseek-v4-pro
      model_type: NVIDIA
      api_key: env::NVIDIA_API_KEY
      endpoint: https://integrate.api.nvidia.com/v1/chat/completions
      temperature: 0.7
      max_tokens: 16384
      timeout: 120
      system_prompt: "你是一个智能助手"
      max_threads: 1
      model_group: PROGRAMMING
      
